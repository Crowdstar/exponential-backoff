<?xml version="1.0" encoding="UTF-8"?>
<!-- Risky and warning verdicts fail the suite: a test that quietly stops asserting anything would otherwise be
     reported and then passed over, leaving a green suite hiding a test that never ran. -->
<phpunit backupGlobals="false" bootstrap="tests/bootstrap.php" verbose="true"
         failOnRisky="true" failOnWarning="true">
    <testsuite name="default">
        <directory suffix="Test.php">tests/unit</directory>
    </testsuite>
    <php>
        <const name="UNDER_PHPUNIT" value="true"/>
    </php>
</phpunit>
