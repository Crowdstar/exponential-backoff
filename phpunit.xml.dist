<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false" bootstrap="tests/bootstrap.php" verbose="true">
    <testsuite name="default">
        <directory suffix="Test.php">tests/unit</directory>
    </testsuite>
    <php>
        <const name="UNDER_PHPUNIT" value="true"/>
    </php>
    <!-- To wait for the whole test suite to finish before printing out the summary information at the end. -->
    <extensions>
        <extension class="Deminy\Counit\CounitExtension"/>
    </extensions>
</phpunit>
